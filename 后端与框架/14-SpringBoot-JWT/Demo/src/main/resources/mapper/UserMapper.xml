<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learning.jwtapi.UserMapper">
  <resultMap id="UserMap" type="com.learning.jwtapi.User"><id property="id" column="id" /><result property="name" column="name" /><result property="email" column="email" /><result property="passwordHash" column="password_hash" /></resultMap>
  <select id="findByEmail" resultMap="UserMap">SELECT id, name, email, password_hash FROM users WHERE email = #{email}</select>
  <select id="findById" resultMap="UserMap">SELECT id, name, email, password_hash FROM users WHERE id = #{id}</select>
  <insert id="insert" parameterType="com.learning.jwtapi.User" useGeneratedKeys="true" keyProperty="id">INSERT INTO users (name, email, password_hash) VALUES (#{name}, #{email}, #{passwordHash})</insert>
</mapper>
